@echo off
rem ============================================================
rem  Startet das Hochladen der 85 Witzeseiten auf modjor.de.
rem
rem  ANLEITUNG
rem  1. Diese Datei kopieren und in "hochladen-witze.bat" umbenennen.
rem  2. Unten das Anwendungspasswort eintragen.
rem  3. Das Anwendungspasswort holst du dir in WordPress unter
rem       Benutzer -> Profil -> Anwendungspasswoerter
rem     Dort einen Namen vergeben ("Upload Witze"), erzeugen lassen,
rem     und die angezeigte Zeichenfolge hier einsetzen - MIT den
rem     Leerzeichen, genau wie angezeigt. Sie wird nur einmal
rem     gezeigt; geht sie verloren, erzeugst du einfach eine neue.
rem
rem  WICHTIG: Nimm NICHT dein Anmeldepasswort. Ein Anwendungspasswort
rem  laesst sich einzeln widerrufen, ohne dass du sonst etwas aenderst.
rem
rem  "hochladen-witze.bat" selbst gehoert NICHT auf GitHub.
rem ============================================================

set WP_APP_PASS=xxxx xxxx xxxx xxxx xxxx xxxx

rem Die Datei upload-witze.py und die 85 Seitendateien muessen im
rem selben Ordner liegen wie diese bat-Datei.
python upload-witze.py

pause
